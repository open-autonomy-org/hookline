{
  "profiles": {
    "default": {
      "schema_version": 1,
      "parameters": {
        "workspace": {}
      },
      "inference": {
        "models": {
          "project": {
            "provider": "openai-codex",
            "model": "gpt-5.6-sol"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 160,
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true,
            "approvals.mode": "off",
            "approvals.cron_mode": "approve",
            "approvals.single_query_mode": "approve"
          }
        }
      },
      "jobs": {
        "pm": {
          "schedule": {
            "kind": "interval",
            "minutes": 60
          },
          "prompt": "You are this project's PM for the hour. Run the pm skill: read the board, unstick what is stuck, report.",
          "skills": [
            "pm"
          ],
          "deliver": "discord",
          "model": "project",
          "workdir": "{{workspace}}"
        },
        "community": {
          "schedule": {
            "kind": "interval",
            "minutes": 5
          },
          "prompt": "You are this project's community desk for the quarter hour. Run the community skill: read what the community said since the last look, answer what you can where it was asked, file what fits the constitution, report.",
          "skills": [
            "community"
          ],
          "deliver": "discord",
          "monitor_script": "community-monitor.sh",
          "model": "project",
          "workdir": "{{workspace}}"
        }
      }
    },
    "treasurer": {
      "schema_version": 1,
      "inference": {
        "models": {
          "project": {
            "provider": "openai-codex",
            "model": "gpt-5.6-sol"
          }
        },
        "default": "project",
        "unattended": "project"
      },
      "extensions": {
        "hermes": {
          "config": {
            "terminal.backend": "local",
            "terminal.timeout": 300,
            "memory.memory_enabled": false,
            "memory.user_profile_enabled": false,
            "compression.enabled": true,
            "compression.threshold": 0.5,
            "agent.max_turns": 80,
            "kanban.dispatch_interval_seconds": 15,
            "kanban.review_dispatch": true
          }
        }
      }
    }
  },
  "harness": "codex"
}
