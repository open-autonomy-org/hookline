{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "bun-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "world"
  ]
}
