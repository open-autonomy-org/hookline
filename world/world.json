{
  "id": "hookline",
  "description": "Hookline's world: the Worker under wrangler dev, with twins of the vendors that send webhooks (Stripe, GitHub, Polar) and a twin app as the target. Nothing in the world calls a real API.",
  "stripEnv": [
    "HERMES_*"
  ],
  "services": [
    {
      "id": "stripe",
      "type": "twin",
      "command": "bun",
      "args": [
        "node_modules/@volter/twin-stripe/src/cli.ts",
        "serve"
      ],
      "port": "auto",
      "injectEnv": "STRIPE_TWIN_URL"
    },
    {
      "id": "target",
      "type": "process",
      "command": "bun",
      "args": [
        "world/target.ts"
      ],
      "port": "auto",
      "portArg": false,
      "injectEnv": "TARGET_URL",
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 30000,
        "intervalMs": 200
      }
    },
    {
      "id": "app",
      "type": "process",
      "command": "bun",
      "args": [
        "world/app.ts"
      ],
      "port": "auto",
      "portArg": false,
      "rootArg": "--persist-to",
      "injectEnv": "HOOKLINE_URL",
      "ready": {
        "httpUrl": "${url}/healthz",
        "timeoutMs": 120000,
        "intervalMs": 500
      }
    },
    {
      "id": "github",
      "type": "process",
      "command": "bun",
      "args": [
        "world/github.ts"
      ],
      "port": "auto",
      "portArg": false,
      "injectEnv": "GITHUB_TWIN_URL",
      "env": {
        "HOOKLINE_GITHUB_WEBHOOK_SECRET": "twin_gh_hookline"
      }
    },
    {
      "id": "polar",
      "type": "process",
      "command": "bun",
      "args": [
        "world/polar.ts"
      ],
      "port": "auto",
      "portArg": false,
      "injectEnv": "POLAR_TWIN_URL",
      "env": {
        "HOOKLINE_POLAR_WEBHOOK_SECRET": "dHdpbl9wb2xhcl9ob29rbGluZQ"
      }
    }
  ]
}
